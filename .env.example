# LLM Configuration
# Provider: "ollama", "gemini", "openAI", "Anthropic", "mistral AI" or "openrouter" (can be changed in web UI)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENROUTER_KEY=
OLLAMA_URL=http://localhost:11434
MISTRAL_KEY=mistral_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Voice Configuration
XVASYNTH_PATH=./Content/xVAsynth
VOICE_MODEL=f4_robot_assaultron

# Speech-to-Text Configuration (Mistral Voxtral)
STT_SAMPLE_RATE=16000
STT_CHUNK_DURATION_MS=480

# Wake Word Configuration (openWakeWord - "Hey Jarvis")
# Requires: pip install openwakeword
WAKE_WORD_ENABLED=true
WAKE_WORD_AUTOSTART=true
# Built-in models: hey_jarvis, alexa, hey_mycroft, hey_rhasspy
WAKE_WORD_MODEL=hey_jarvis
# Detection sensitivity 0.0-1.0 (lower = easier to trigger, more false positives)
WAKE_WORD_THRESHOLD=0.4
# Microphone input device index (leave blank for system default)
WAKE_WORD_DEVICE_INDEX=
# Seconds to wait for you to START talking before standing by
WAKE_CAPTURE_TIMEOUT=8
# Seconds of silence after you stop talking that ends the command
WAKE_SILENCE_GAP=2.0
# Hard cap on a single command capture (seconds)
WAKE_MAX_CAPTURE=20

DISCORD_WEBHOOK_URL=
DISCORD_LOG_URL=

# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_guild_id_here

API_USERNAME=admin
API_PASSWORD=your_secure_password_here

BRAVE_BROWSER_API_KEY=

SANDBOX_PATH=./src/sandbox

# Email Configuration
AI_EMAIL_ADDRESS=
AI_EMAIL_PASSWORD=
SMTP_SERVER=
SMTP_PORT=587
IMAP_SERVER=
IMAP_PORT=993
EMAIL_ENABLED=false
EMAIL_RATE_LIMIT=10
ALLOWED_EMAIL_DOMAINS=gmail.com,example.com
EMAIL_SIGNATURE_ENABLED=true
AI_NAME=ASR-7

# GitHub Configuration
GITHUB_USERNAME=
GITHUB_TOKEN=
SSH_KEY_PATH=./ssh/ai_github_key
GIT_USER_NAME=AI Bot
GIT_USER_EMAIL=
GIT_ENABLED=false
REQUIRE_COMMIT_MESSAGE_FORMAT=true